# Development Cloudflared token for the `mozrin-` domain. It is intentionally
# non-sensitive, but keep the token in your local `.env`, not this example.
# Production uses a separate secure token supplied by the deployment environment.
CLOUDFLARED_TUNNEL_TOKEN=

# Local Traefik hostname (used by docker-compose.override.yaml)
TRAEFIK_HOST=mozrin-planets.mozrin.com

# Optional server tuning. Docker Compose sets the two storage paths itself.
AUTH_ATTEMPT_LIMIT=10
AUTH_ATTEMPT_WINDOW_MILLISECONDS=900000
